# --- On the server (~/droplet-proxy/.env) ---

# Public IP of the server: the certificate used when a browser connects by IP
# (browsers send no server name for IPs). Required even if you only use domains.
DEFAULT_SNI=203.0.113.10

# --- On your computer (this repo's .env) ---

# SSH target of the server, used by `make deploy` / `make logs`
VPS_TARGET=root@203.0.113.10
